rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profils Utilisateurs : Seul le propriétaire ou un admin peut lire/écrire
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Leaderboard : Tout le monde lit, seul le propriétaire met à jour son score
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Marché : Lecture publique, écriture pour les connectés
    match /market/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Commandes Admin
    match /admin_commands/{cmdId} {
      allow read, write: if request.auth != null;
    }

    // Logs d'administration (Correction de l'erreur logAdminAction)
    match /admin_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Récompenses en attente
    match /pending_rewards/{rewardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ordres : Seul le propriétaire gère ses ordres
    match /orders/{orderId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.userId == request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // Historique des échanges : Lecture publique
    match /trades/{tradeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
