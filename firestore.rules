rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissive rules for demo/development
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admin Commands: keep slightly more restrictive or just allow if demo
    match /admin_commands/{cmdId} {
      allow read, write: if true;
    }
  }
}
